# ==============================================================================
# FTC Robot Controller SDK - Recommended .gitignore
# ==============================================================================

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Keep required vendor AARs if placed in libs
!libs/*.aar

# Files for the ART/Dalvik VM
*.dex

# Java/JDK files
*.class
*.hprof

# Generated and build files
bin/
gen/
out/
build/
*/build/
.gradle/

# Local configuration file (Android SDK path specific to each machine)
local.properties

# Log files
*.log

# Proguard / Lint
proguard/
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Android Studio & IntelliJ IDEA
# Each contributor's IDE will regenerate project files automatically
.idea/
*.iml
.navigation/
captures/
vcs.xml

# Keystore files
# Ignore private keystores, but keep the SDK's built-in ftc.debug.keystore
*.jks
*.keystore
!libs/ftc.debug.keystore

# Native build folders
.externalNativeBuild
.cxx/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
*~
*.swp
